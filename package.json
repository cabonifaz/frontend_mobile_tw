{
  "name": "app_mobile_tw",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.16",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-updates": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "apk": "npx eas-cli@latest build -p android --profile preview",
    "apk:dev": "npx eas-cli@latest build -p android --profile development",
    "actualizar": "npx eas-cli@latest update --channel preview --environment preview --platform android --message",
    "modo:demo": "npx eas-cli@latest env:set --environment preview --name EXPO_PUBLIC_USE_MOCK --value true --visibility plaintext --non-interactive",
    "modo:real": "npx eas-cli@latest env:set --environment preview --name EXPO_PUBLIC_USE_MOCK --value false --visibility plaintext --non-interactive"
  },
  "private": true
}
