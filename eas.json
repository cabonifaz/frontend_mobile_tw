{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REEMPLAZAR-URL-STAGING.up.railway.app",
        "EXPO_PUBLIC_USE_MOCK": "false"
      }
    },
    "preview-demo": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_USE_MOCK": "true"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {}
  }
}
